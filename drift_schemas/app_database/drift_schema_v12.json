    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "user_profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profile\" (\"id\" INTEGER NOT NULL DEFAULT 0, \"sex\" TEXT NOT NULL, \"birth_date\" INTEGER NOT NULL, \"height_cm\" REAL NOT NULL, \"weight_kg\" REAL NOT NULL, \"bmr_kcal_override\" INTEGER NULL, \"daily_kcal_goal_override\" INTEGER NULL, \"daily_goal_preset\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (id = 0));"
        }
      ]
    },
    {
      "name": "foods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"foods\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"brand\" TEXT NULL, \"barcode\" TEXT NULL, \"aliases\" TEXT NULL, \"servings\" TEXT NULL, \"status\" TEXT NULL, \"basis\" TEXT NULL, \"notes\" TEXT NULL, \"source\" TEXT NOT NULL, \"kcal\" INTEGER NULL, \"carb_g\" REAL NULL, \"protein_g\" REAL NULL, \"fat_g\" REAL NULL, \"sugar_g\" REAL NULL, \"saturated_fat_g\" REAL NULL, \"sodium_mg\" REAL NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "meals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meals\" (\"id\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, \"meal_type\" TEXT NOT NULL, \"note\" TEXT NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "meal_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_items\" (\"id\" TEXT NOT NULL, \"meal_id\" TEXT NOT NULL REFERENCES meals (id) ON DELETE CASCADE, \"food_id\" TEXT NULL, \"name\" TEXT NOT NULL, \"grams\" REAL NOT NULL, \"kcal\" INTEGER NOT NULL, \"carb_g\" REAL NOT NULL, \"protein_g\" REAL NOT NULL, \"fat_g\" REAL NOT NULL, \"salt_g\" REAL NOT NULL, \"source\" TEXT NOT NULL, \"confidence\" REAL NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "daily_exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_exercises\" (\"day_key\" INTEGER NOT NULL, \"kcal\" INTEGER NOT NULL, PRIMARY KEY (\"day_key\"));"
        }
      ]
    },
    {
      "name": "weight_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weight_entries\" (\"day_key\" INTEGER NOT NULL, \"weight_kg\" REAL NOT NULL, PRIMARY KEY (\"day_key\"));"
        }
      ]
    }
