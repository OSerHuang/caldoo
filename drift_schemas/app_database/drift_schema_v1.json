      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercises\" (\"id\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, \"type\" TEXT NOT NULL, \"minutes\" REAL NOT NULL, \"met\" REAL NOT NULL, \"kcal\" REAL NOT NULL, \"overridden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"overridden\" IN (0, 1)), PRIMARY KEY (\"id\"));"
